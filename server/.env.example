# ============================================================================
# 后端环境变量样例（server/.env.example）
# 复制为 server/.env 后填写真实值；.env 已在 .gitignore 中，任何真实密钥不得入库
# 命名规范：SHOP__ 前缀 + 大写下划线分层，见 docs/02-architecture.md §5.4
# ============================================================================

# ---------- 运行环境 ----------
NODE_ENV=development

# ---------- 服务 ----------
SHOP__SERVER__HOST=0.0.0.0
SHOP__SERVER__PORT=3000
SHOP__SERVER__BASE_URL=http://localhost:3000

# ---------- 数据库 ----------
# 格式：mysql://user:pass@host:3306/shop_web
SHOP__DB__URL=<fill-me>

# ---------- Redis（限流 / 缓存 / 锁 / BullMQ 队列底座）----------
SHOP__REDIS__URL=redis://localhost:6379/0

# ---------- JWT（C 端与后台密钥分离，作用域隔离）----------
# 生产环境必须替换为 >= 32 位的强随机串
SHOP__JWT__ACCESS_SECRET=<fill-me-32-chars-min>
SHOP__JWT__REFRESH_SECRET=<fill-me-32-chars-min>
SHOP__JWT__ADMIN_ACCESS_SECRET=<fill-me-32-chars-min>
SHOP__JWT__ADMIN_REFRESH_SECRET=<fill-me-32-chars-min>
SHOP__JWT__ACCESS_TTL=2h
SHOP__JWT__REFRESH_TTL=7d

# ---------- 上传 ----------
SHOP__UPLOAD__DIR=uploads
SHOP__UPLOAD__MAX_SIZE=5242880
SHOP__UPLOAD__BASE_URL=/static

# ---------- 支付渠道路由（mock / alipay / wechat / unionpay；生产禁止 mock）----------
SHOP__ADAPTER__PAYMENT__PROVIDER=mock

# ---------- 订单业务规则 ----------
SHOP__ORDER__PAY_TIMEOUT_MINUTES=30
SHOP__ORDER__AUTO_CONFIRM_DAYS=15
SHOP__ORDER__AFTER_SALE_DAYS=7

# ---------- 运费规则（单位：分）----------
SHOP__FREIGHT__FREE_THRESHOLD=9900
SHOP__FREIGHT__FEE=1200

# ---------- 库存 ----------
SHOP__STOCK__DEDUCT_MODE=order
SHOP__STOCK__WARNING_THRESHOLD=10

# ---------- 限流 ----------
SHOP__RATE_LIMIT__ENABLED=true

# ---------- CORS（逗号分隔白名单）----------
SHOP__CORS__ORIGINS=http://localhost:5173

# ---------- 日志 ----------
SHOP__LOG__LEVEL=info
SHOP__LOG__DIR=logs

# ---------- 前端站点地址（支付回调 returnUrl / mock 收银台跳转用）----------
SHOP__WEB__BASE_URL=http://localhost:5173

# ---------- 积分体系（第二阶段，一期恒 false）----------
SHOP__POINT__ENABLED=false
