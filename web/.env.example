# ============================================================================
# 前端环境变量样例（复制为 .env.development / .env.production）
# 只有 VITE_ 前缀的变量才会被打进前端产物，禁止在此填写任何密钥
# ============================================================================

# 接口基地址：开发走 Vite 代理（/api → http://localhost:3000）
VITE_API_BASE=/api

# 站点标题
VITE_APP_TITLE=电商商城系统
