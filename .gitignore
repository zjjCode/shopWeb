# ============================================================================
# 根目录 .gitignore · 电商商城系统（server/ + web/ 双包）
# @see docs/02-architecture.md §3、§4
# ============================================================================

# 依赖
node_modules/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# 构建产物
dist/
build/
.cache/
.vite/
coverage/

# 环境变量（只提交 .env.example，任何真实密钥不得入库）
.env
.env.*
!.env.example

# 日志与上传（运行期生成）
logs/
*.log
uploads/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 测试产物
.nyc_output/
tests/**/*.snap

# 工作台运行时数据（memory / 会话缓存，非项目源码，频繁变动）
.workbuddy/
